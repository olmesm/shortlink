    <Compile Include="Ui/WebhooksUi.fs" />
    <Compile Include="Ui/OverviewUi.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Falco" Version="5.2.0" />
    <PackageReference Include="Falco.Markup" Version="1.4.0" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.3.13" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="UAParser" Version="3.1.47" />
    <PackageReference Include="MaxMind.GeoIP2" Version="5.2.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shortlink.Core\Shortlink.Core.fsproj" />
    <ProjectReference Include="..\Shortlink.Data\Shortlink.Data.fsproj" />
  </ItemGroup>

</Project>
